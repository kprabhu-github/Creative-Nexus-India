# Creative Nexus Command Centre — example env vars
# Copy to .env.local and fill in values. See SETUP-GUIDE.md for the full set.

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Anthropic (agents) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Cron auth ─────────────────────────────────────────────────────────────
CRON_SECRET=

# ── Email Core: encryption + sending ──────────────────────────────────────
# Generate with: openssl rand -hex 32
EMAIL_ENCRYPTION_KEY=

# Google OAuth (Gmail Core)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/email/oauth/google/callback

# Email Core
MAIL_DOMAIN=creativenexus.in
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_WORKER_CRON_SECRET=

# ── Apify (LinkedIn scrapers) ─────────────────────────────────────────────
APIFY_API_TOKEN=
APIFY_LINKEDIN_PROFILE_ACTOR=
APIFY_LINKEDIN_COMPANY_ACTOR=

# ── NVIDIA (quality layer) ────────────────────────────────────────────────
NVIDIA_API_KEY=

# ── Gravity Forms / WooCommerce ───────────────────────────────────────────
GRAVITY_FORMS_PUBLIC_KEY=
GRAVITY_FORMS_PRIVATE_KEY=
WOOCOMMERCE_URL=

# ── SMTP fallback ─────────────────────────────────────────────────────────
SMTP_CC=
